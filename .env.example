# .env.example
# Copie para .env em desenvolvimento local e substitua pelos valores reais.

# Driver: mysql ou pgsql
DB_DRIVER=pgsql

# Supabase/PostgreSQL
# No Vercel, prefira configurar POSTGRES_URL ou DATABASE_URL nas Environment Variables.
# Exemplo:
# POSTGRES_URL=postgres://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=
DB_SCHEMA=lab_hardware
DB_SSLMODE=require

# MySQL local via Docker Compose
DB_HOST=db
DB_PORT=3306
DB_NAME=lab_hardware
DB_USER=lab_user
DB_PASS=lab_password

# Porta local da aplicação
APP_PORT=8080
DB_EXTERNAL_PORT=3307
